# Exchange API credentials (needs trade permission only if dry_run: false in config.yaml)
EXCHANGE_API_KEY=
EXCHANGE_API_SECRET=
# Only needed for Kucoin (API passphrase)
EXCHANGE_API_PASSWORD=

# Telegram bot: create via @BotFather, then message your bot once and
# fetch your chat id from https://api.telegram.org/bot<token>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional: API key for the LLM second-opinion feature. Provider is set in
# config.yaml (llm.provider): openai, anthropic, gemini, grok, or mistral.
LLM_API_KEY=
